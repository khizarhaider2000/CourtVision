# OpenAI API key — required only if you want AI-powered query parsing.
# Without this key, the app falls back to the rule-based parser.
OPENAI_API_KEY=your_openai_api_key_here

# Comma-separated list of allowed frontend origins for CORS.
# In production, set this to your Vercel deployment URL.
# Example: CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
